# Configuração local de desenvolvimento
DATABASE_URL=postgresql+psycopg:///pulseops_ai

# Triagem: mock = regras locais demonstrativas; openai = IA real (chamada externa).
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=10
