# Configuração local de desenvolvimento
DATABASE_URL=postgresql+psycopg:///pulseops_ai

# Triagem: mock = regras locais; openai = API externa; ollama = LLM local.
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=10
# Defina apenas no backend, nunca no frontend ou em commits.
# OPENAI_API_KEY=

# Ollama local (Windows: instale Ollama e execute 'ollama pull qwen2.5:3b').
# AI_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120

# Configuração de execução (produção somente depois de revisão).
APP_ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# JWT_SECRET_KEY=GERE_UM_SEGREDO_FORTE_E_PRIVADO
# OLLAMA_BASE_URL=http://127.0.0.1:11434
