# Configuração local de desenvolvimento
DATABASE_URL=postgresql+psycopg:///pulseops_ai

# Triagem: mock = regras locais; openai = API externa; ollama = LLM local.
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=10
# Defina apenas no backend, nunca no frontend ou em commits.
# OPENAI_API_KEY=

# Ollama local (Windows: instale Ollama e execute 'ollama pull qwen2.5:3b').
# AI_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120
