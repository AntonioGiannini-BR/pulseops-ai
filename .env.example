# SOMENTE PARA DESENVOLVIMENTO LOCAL
# Copie para .env e substitua por uma senha forte, mantida fora do Git.
POSTGRES_DB=pulseops_db
POSTGRES_USER=pulseops_dev
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
POSTGRES_PORT=5432

# Exclusivo do stack completo em compose.app.yaml. Gerar segredo aleatório.
JWT_SECRET_KEY=ALTERE_ISTO_GERE_UM_SEGREDO_ALEATORIO_COM_32_CARACTERES
APP_PORT=8080
AI_PROVIDER=mock
# OPENAI_API_KEY=
# Para usar IA no container: AI_PROVIDER=ollama e OLLAMA_BASE_URL=http://ollama:11434
